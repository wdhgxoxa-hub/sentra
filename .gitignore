# ---------------------------------------------------------------
# SENTRA - .gitignore
# ---------------------------------------------------------------

# Clones de terceros: se archivaron fuera del proyecto (AUD2-017,
# F:\archivo_sentra\repos); que no vuelvan a entrar por error.
repos/

# Entornos virtuales
.venv/
venv/
ENV/
env/
.python-version

# Bytecode y caches de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Empaquetado
build/
dist/
*.egg-info/
*.egg

# Almacenes vectoriales: LanceDB / ChromaDB / SQLite
data/lancedb/
data/test_lance/
*.lance/
*.lance
.lancedb/
chroma/
.chroma/
chroma.sqlite3
*.db
*.sqlite
*.sqlite3
*.duckdb

# Salidas de los scripts: nada generado se versiona (D5).
*.log
logs/*

# Secretos y configuración local
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json

# Temporales del sistema y del editor
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace

# Modelos descargados / caches de HuggingFace y ONNX
models/
.cache/
*.onnx
*.safetensors
*.bin

# Frontend (Tauri + React)
ui/node_modules/
ui/dist/
ui/.vite/
ui/.tsbuild/
ui/src-tauri/target/
ui/src-tauri/gen/
*.tsbuildinfo
