# SENTRA - plantilla de configuración
#
# Copia este archivo a .env y rellena los valores. El .env real está
# ignorado por git; este ejemplo no debe contener credenciales.

# ---------------------------------------------------------------
# Credenciales de Reddit (OAuth2)
# ---------------------------------------------------------------
# Reddit cerró el acceso anónimo a los endpoints .json: devuelven 403 o
# redirigen a /login. Para leer sin fricción hace falta una aplicación
# propia, que es gratuita:
#
#   1. Entra en https://www.reddit.com/prefs/apps
#   2. "create another app...", tipo "script"
#   3. redirect uri: http://localhost:8080  (no se usa, pero es obligatoria)
#   4. client_id  = la cadena bajo el nombre de la app
#      client_secret = el campo "secret"

RIR_REDDIT_CLIENT_ID=
RIR_REDDIT_CLIENT_SECRET=

# Opcionales. Si los rellenas, se usa el flujo "password" en nombre del
# usuario, con límites de cuota más holgados que el modo solo-aplicación.
RIR_REDDIT_USERNAME=
RIR_REDDIT_PASSWORD=

# Reddit pide un User-Agent que identifique la aplicación y a su autor.
RIR_REDDIT_USER_AGENT=python:sentra:v0.5 (by /u/tu_usuario)

# ---------------------------------------------------------------
# Almacenamiento
# ---------------------------------------------------------------
# Ruta del almacén LanceDB. Si se omite, <raíz del proyecto>/data/lancedb.
# RIR_LANCEDB_PATH=
